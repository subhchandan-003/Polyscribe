# Copy this file to .env.local for local development.
# On Vercel, set this under Project Settings -> Environment Variables
# (or run `vercel env add`) for Production, Preview, and Development.

# Anthropic Claude API key — used for transcript cleanup and SOAP note
# generation (src/lib/claude.ts, src/lib/transcribe.ts). Audio is
# transcribed client-side via the browser's Web Speech API — no other
# provider key is required.
ANTHROPIC_API_KEY=
