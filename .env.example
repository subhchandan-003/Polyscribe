# Copy this file to .env.local for local development.
# On Vercel, set this under Project Settings -> Environment Variables
# (or run `vercel env add`) for Production, Preview, and Development.

# Anthropic Claude API key, used for transcript cleanup and SOAP note
# generation (src/lib/claude.ts, src/lib/transcribe.ts).
ANTHROPIC_API_KEY=

# Groq API key (https://console.groq.com), used to run whisper-large-v3
# for a more accurate final transcription pass on the recorded audio
# once a consultation ends (src/app/api/whisper-transcribe/route.ts).
# The browser's Web Speech API still drives the live in-recording
# preview; this key is optional, if unset the app falls back to the
# Web Speech transcript as the final one.
GROQ_API_KEY=
